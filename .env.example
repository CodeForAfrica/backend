# Required. Use a reachable existing database with its existing schema.
# Percent-encode reserved characters in user/password/database names.
MC_DATABASE_URL=postgresql://user:password@database.example.org:5432/mediacloud
# Set these to your existing mail service if account activation/notifications are used.
MC_SMTP_HOST=mail.example.org
MC_SMTP_PORT=25
MC_HTTP_PORT=8082
# Local only; ECS requires a separate secret instead of this default.
MC_RABBITMQ_PASSWORD=civicsignal-local
